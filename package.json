{
  "name": "@kaira/widget",
  "version": "0.1.0",
  "private": true,
  "description": "KAIRA accessibility widget — embeddable script for any website",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/copy-extensions.cjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "terser": "^5.37.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
